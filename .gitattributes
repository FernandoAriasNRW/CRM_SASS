# Normaliza finales de línea: LF en el repositorio, nativo en el working tree.
* text=auto

# Archivos que deben conservar LF siempre (scripts ejecutados en Linux/CI)
*.sh        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
Dockerfile  text eol=lf
*.conf      text eol=lf

# Archivos que deben conservar CRLF (herramientas Windows)
*.ps1       text eol=crlf
*.cmd       text eol=crlf
*.bat       text eol=crlf

# Binarios
*.png       binary
*.jpg       binary
*.ico       binary
*.webm      binary
*.pdf       binary
*.woff      binary
*.woff2     binary
