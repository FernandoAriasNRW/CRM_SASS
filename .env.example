# Copiar a `.env` y rellenar con valores reales. `.env` está ignorado por git.
#   cp .env.example .env

# ─────────────────────────────────────────────────────────── Base de datos
MYSQL_ROOT_PASSWORD=cambiar-root-password
MYSQL_DATABASE=CrmDb
MYSQL_USER=crm_app
MYSQL_PASSWORD=cambiar-password-de-aplicacion

# ─────────────────────────────────────────────────────────── API
# Mínimo 32 caracteres. Generar con:
#   openssl rand -base64 48
JWT_KEY=cambiar-por-una-clave-aleatoria-de-al-menos-32-caracteres
JWT_ISSUER=crm-saas-api
JWT_AUDIENCE=crm-saas-web

# ─────────────────────────────────────────────────────────── RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=cambiar-password-rabbitmq

# ─────────────────────────────────────────── Ficheros adjuntos de Documentos
# Opcional. Con las tres puestas, los adjuntos y las imágenes van a Cloudinary.
# Sin ellas se guardan en el disco del servidor, que funciona sin configurar nada
# pero no se comparte entre réplicas.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─────────────────────────────────────────── Siembra y primer administrador
# Todo apagado por defecto, en cualquier entorno. Se enciende a mano, aquí.
#
# Sembrar la organización de demostración (admin@acme.com) al arrancar la API.
DEMO_DATA_SEED_ON_STARTUP=false
# Exponer POST /api/v1/admin/seed-database para sembrarla a mano (sólo Admin).
DEMO_DATA_ALLOW_SEED_ENDPOINT=false
# Primer administrador, sólo si la base no tiene ningún usuario. Contraseña de 12+ caracteres.
# Sin esto y sin siembra, una base vacía arranca sin nadie que pueda iniciar sesión.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
