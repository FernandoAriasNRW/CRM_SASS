{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // ─────────────────────────────────────────────────────────────────────────
  // NO poner credenciales reales en este archivo: se versiona en git.
  //
  // Desarrollo local  -> appsettings.Development.json (ignorado por git)
  //                      o `dotnet user-secrets set "Jwt:Key" "<valor>"`
  // Producción        -> variables de entorno o Key Vault, p. ej.
  //                      ConnectionStrings__MySql, Jwt__Key
  //
  // La aplicación falla al arrancar si Jwt:Key o la cadena de conexión
  // están vacías (ver validación en Program.cs).
  // ─────────────────────────────────────────────────────────────────────────
  "ConnectionStrings": {
    "DefaultConnection": "",
    "MySql": ""
  },
  "Database": {
    "Provider": "MySql"
  },
  "Jwt": {
    "Key": "",
    "Issuer": "CrmApi",
    "Audience": "CrmClients",
    "ExpiryInMinutes": 60,
    "RefreshTokenExpiryInDays": 7
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  }
}
