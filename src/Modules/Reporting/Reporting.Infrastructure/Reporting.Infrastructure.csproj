<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Sin referencias a otros módulos. Había seis —a Projects, WorkItems y Ticketing, con sus
       capas de infraestructura incluidas— para que DashboardRepository pudiera consultar sus
       DbContext directamente, lo que rompía de lleno la regla de aislamiento: un cambio en el
       esquema de otro módulo llegaba hasta aquí sin pasar por ningún contrato.

       Esas consultas viven ahora en ApiHost/Reporting/ConsultasDelPanel.cs. El host es donde el
       proyecto compone lo que cruza módulos, igual que PuenteDeAutomatizaciones. Reporting
       sigue declarando el contrato; sólo cambia quién lo implementa. -->
  <ItemGroup>
    <ProjectReference Include="..\Reporting.Application\Reporting.Application.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\BuildingBlocks.Infrastructure\BuildingBlocks.Infrastructure.csproj" />
  </ItemGroup>

</Project>
